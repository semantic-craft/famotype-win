 #include "CandidateList.h"
 #include "ResponseParser.h"
 
+namespace {
+// 法墨中英/中数字自动加空格：commit 字符边界分类（移植 macOS
+// FamoCommitTransform 的 BoundaryKind/classify）。
+FamoBoundaryKind FamoClassify(wchar_t ch) {
+  if (ch >= 0x3400 && ch <= 0x9FFF)
+    return FamoBoundaryKind::CJK;
+  if (ch >= 0xF900 && ch <= 0xFAFF)
+    return FamoBoundaryKind::CJK;
+  // 0x20000-0x2FA1F(CJK 扩展区)在 UTF-16 里是代理对，逐 wchar_t 遍历时高低
+  // 代理项都不落在以上范围，天然归 None——只是"不加空格"，不会"加错位置"。
+  if ((ch >= L'A' && ch <= L'Z') || (ch >= L'a' && ch <= L'z'))
+    return FamoBoundaryKind::Latin;
+  if (ch >= L'0' && ch <= L'9')
+    return FamoBoundaryKind::Digit;
+  return FamoBoundaryKind::None;  // 空白/标点：打断边界判定，同 Mac 的 nil 语义
+}
+
+// 法墨中英/中数字自动加空格：两个开关各自独立生效。
+bool FamoNeedsSpace(FamoBoundaryKind left,
+                    FamoBoundaryKind right,
+                    bool cjk_english,
+                    bool cjk_number) {
+  bool is_cjk_latin =
+      (left == FamoBoundaryKind::CJK && right == FamoBoundaryKind::Latin) ||
+      (left == FamoBoundaryKind::Latin && right == FamoBoundaryKind::CJK);
+  bool is_cjk_digit =
+      (left == FamoBoundaryKind::CJK && right == FamoBoundaryKind::Digit) ||
+      (left == FamoBoundaryKind::Digit && right == FamoBoundaryKind::CJK);
+  if (is_cjk_latin)
+    return cjk_english;
+  if (is_cjk_digit)
+    return cjk_number;
+  return false;
+}
+}  // namespace
