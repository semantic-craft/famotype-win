+          {L'\x300C', L'\x300D'}, /* 「」 */
+          {L'\x300E', L'\x300F'}, /* 『』 */
+          {L'\x300A', L'\x300B'}, /* 《》 */
+          {L'\x3010', L'\x3011'}, /* 【】 */
+          {L'\x3014', L'\x3015'}, /* 〔〕 */
+          {L'\x3008', L'\x3009'}, /* 〈〉 */
+      };
+      // type-over 仅限"标点直接上屏"（无 preedit），避免打断组句。
