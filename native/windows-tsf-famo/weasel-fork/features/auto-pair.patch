+
+/* 法墨标点配对：commit 后注入方向键移动光标（←回到配对中间 / →越过右符号）。
+ * 与商业输入法（搜狗等）同方案：TSF SetSelection 在 CUAS/EDIT 控件下
+ * 会被结束 composition 时的光标同步覆盖，注入方向键则普适。
+ * 注入键会先过本 IME 的 key sink：无 composition 时不吃、直达应用。
+ * 中文括号多为 Shift 组合键（Shift+9 → （），注入时用户的修饰键可能仍
+ * 物理按住，Shift+←/→ 会变成选区扩展、Ctrl+← 变成词跳——先松开、注入、
+ * 再恢复，保证方向键以裸键落地。 */
+void WeaselTSF::_FamoInjectArrow(WORD vk, int count) {
+  static const WORD kMods[] = {VK_LSHIFT,   VK_RSHIFT, VK_LCONTROL,
+                               VK_RCONTROL, VK_LMENU,  VK_RMENU};
+  const int kModCount = sizeof(kMods) / sizeof(kMods[0]);
+  INPUT seq[kModCount * 2 + 8];
+  memset(seq, 0, sizeof(seq));
+  int n = 0;
+  bool held[kModCount];
+  for (int m = 0; m < kModCount; ++m) {
+    held[m] = (::GetAsyncKeyState(kMods[m]) & 0x8000) != 0;
+    if (held[m]) {
+      seq[n].type = INPUT_KEYBOARD;
+      seq[n].ki.wVk = kMods[m];
+      seq[n].ki.dwFlags = KEYEVENTF_KEYUP;
+      ++n;
+    }
+  }
+  for (int i = 0; i < count && i < 4; ++i) {
+    seq[n].type = INPUT_KEYBOARD;
+    seq[n].ki.wVk = vk;
+    ++n;
+    seq[n].type = INPUT_KEYBOARD;
+    seq[n].ki.wVk = vk;
+    seq[n].ki.dwFlags = KEYEVENTF_KEYUP;
+    ++n;
+  }
+  for (int m = 0; m < kModCount; ++m) {
+    if (held[m]) {
+      seq[n].type = INPUT_KEYBOARD;
+      seq[n].ki.wVk = kMods[m];
+      ++n;
+    }
+  }
+  ::SendInput(n, seq, sizeof(INPUT));
+}
+
+/* 法墨标点配对 type-over：光标为空选区且右侧紧邻字符 == ch 时，右移越过。
+ * 任一 COM 调用失败（应用不支持读周边文本）→ 返回 FALSE，走正常插入。 */
+int WeaselTSF::_FamoProbeNextChar(TfEditCookie ec, wchar_t ch) {
+  TF_SELECTION selection;
+  ULONG nSelection = 0;
+  if (FAILED(_pEditSessionContext->GetSelection(ec, TF_DEFAULT_SELECTION, 1,
+                                                &selection, &nSelection)) ||
+      nSelection == 0 || selection.range == nullptr)
+    return -1;
+
+  int result = -1;
+  BOOL empty = FALSE;
+  com_ptr<ITfRange> pProbe;
+  com_ptr<ITfRange> pDocEnd;
+  if (SUCCEEDED(selection.range->IsEmpty(ec, &empty)) && empty &&
+      SUCCEEDED(selection.range->Clone(&pProbe)) &&
+      SUCCEEDED(_pEditSessionContext->GetEnd(ec, &pDocEnd))) {
+    WCHAR buf[2] = {0, 0};
+    ULONG cchRead = 0;
+    pProbe->Collapse(ec, TF_ANCHOR_END);
+    /* 探针末端推到文档末尾，GetText 只取光标后首字符。
+     * transitory/CUAS 上下文读不到周边文本（读出 0 字符）→ 返回未知 */
+    if (SUCCEEDED(pProbe->ShiftEndToRange(ec, pDocEnd, TF_ANCHOR_END)) &&
+        SUCCEEDED(pProbe->GetText(ec, 0, buf, 1, &cchRead)) && cchRead == 1)
+      result = (buf[0] == ch) ? 1 : 0;
+  }
+  selection.range->Release();
+  return result;
+}
