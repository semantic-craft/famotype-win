diff --git a/WeaselServer/WeaselServerApp.cpp b/WeaselServer/WeaselServerApp.cpp
index 3789752..f8b0ac4 100644
--- a/WeaselServer/WeaselServerApp.cpp
+++ b/WeaselServer/WeaselServerApp.cpp
@@ -30,14 +30,105 @@ int WeaselServerApp::Run() {
   m_ui.Create(m_server.GetHWnd());
 
   m_handler->Initialize();
-  m_handler->OnUpdateUI([this]() { tray_icon.Refresh(); });
+  m_handler->OnUpdateUI([this]() {
+    tray_icon.Refresh();
+    // 法墨状态栏：从真实 Rime 状态同步中英/全半角（Rime 无 GetOption）。
+    m_status_bar.SyncStatus(m_ui.status().ascii_mode, m_ui.status().full_shape);
+    // 皮肤跟随候选窗（含 famo-style.yaml 覆盖 / 深色切换）；带变更检测，不会每次重建。
+    m_status_bar.ApplySkin(m_ui.style());
+    m_popup.ApplySkin(m_ui.style());
+    m_context_popup.ApplySkin(m_ui.style());
+  });
 
   tray_icon.Create(m_server.GetHWnd());
   tray_icon.Refresh();
 
+  // 法墨悬浮状态栏（阶段 1）：开关回调直达同进程 RimeWithWeaselHandler::SetOption
+  // （ipc_id=0 -> 活跃 session），零 IPC。创建后置于主屏右下角并显示。
+  m_status_bar.Bind([this](const std::string& opt, bool val) {
+    m_handler->SetOption(0, opt, val);
+  });
+  // 拖动位置持久化：%LOCALAPPDATA%\Famo\famo-statusbar.txt（跨会话记住）。
+  m_status_bar.SetStatePath((WeaselUserDataPath() / L"famo-statusbar.txt").wstring());
+  if (m_status_bar.CreateBar(m_server.GetHWnd()))
+    m_status_bar.ApplySkin(m_ui.style());  // 初次套皮肤（与候选窗一致）
+  // 焦点驱动显隐：编辑域获得焦点 -> 显示（跟随前台窗/或固定拖动位）；失焦 -> 隐藏。
+  m_handler->OnFocusIn([this] { m_status_bar.ShowOnFocus(); });
+  m_handler->OnFocusOut([this] { m_status_bar.HideBar(); });
+
+  // 法墨弹出面板（阶段 2）：4 开关复用状态栏单一真相源 + 设定/关于/退出动作。
+  {
+    std::filesystem::path dir = install_dir();
+    std::vector<FamoPopupPanel::Item> items;
+    items.push_back({L"输入法设定",
+                     [dir] { launch_famo_settings(dir, L"input"); },
+                     nullptr});
+    items.push_back({L"英文输入",
+                     [this] { m_status_bar.ToggleOption("ascii_mode"); },
+                     [this] { return m_status_bar.QueryOption("ascii_mode"); }});
+    items.push_back(
+        {L"英文标点", [this] { m_status_bar.ToggleOption("ascii_punct"); },
+         [this] { return m_status_bar.QueryOption("ascii_punct"); }});
+    items.push_back(
+        {L"繁体输出",
+         [this] { m_status_bar.ToggleOption("traditionalization"); },
+         [this] { return m_status_bar.QueryOption("traditionalization"); }});
+    items.push_back({L"全角", [this] { m_status_bar.ToggleOption("full_shape"); },
+                     [this] { return m_status_bar.QueryOption("full_shape"); }});
+    items.push_back({L"关于",
+                     [dir] { launch_famo_settings(dir, L"about"); },
+                     nullptr});
+    items.push_back({L"退出", [this] { m_server.Stop(); }, nullptr});
+    m_popup.SetItems(std::move(items));
+    m_popup.CreatePanel(m_server.GetHWnd());
+    m_popup.ApplySkin(m_ui.style());  // 初次套皮肤（与候选窗+状态栏一致）
+    m_status_bar.OnExpand(
+        [this] { m_popup.Toggle(m_status_bar.AnchorTopLeftScreen()); });
+  }
+
+  // 法墨右键菜单：只放已实现动作，不展示语音/软键盘/扩展中心等空按钮。
+  {
+    std::filesystem::path dir = install_dir();
+    std::vector<FamoPopupPanel::Item> items;
+    items.push_back({L"输入法设定",
+                     [dir] { launch_famo_settings(dir, L"input"); },
+                     nullptr});
+    items.push_back({L"英文输入",
+                     [this] { m_status_bar.ToggleOption("ascii_mode"); },
+                     [this] { return m_status_bar.QueryOption("ascii_mode"); }});
+    items.push_back(
+        {L"英文标点", [this] { m_status_bar.ToggleOption("ascii_punct"); },
+         [this] { return m_status_bar.QueryOption("ascii_punct"); }});
+    items.push_back(
+        {L"繁体输出",
+         [this] { m_status_bar.ToggleOption("traditionalization"); },
+         [this] { return m_status_bar.QueryOption("traditionalization"); }});
+    items.push_back({L"全角", [this] { m_status_bar.ToggleOption("full_shape"); },
+                     [this] { return m_status_bar.QueryOption("full_shape"); }});
+    items.push_back({L"关于",
+                     [dir] { launch_famo_settings(dir, L"about"); },
+                     nullptr});
+    items.push_back({L"退出", [this] { m_server.Stop(); }, nullptr});
+    m_context_popup.SetItems(std::move(items));
+    m_context_popup.CreatePanel(m_server.GetHWnd());
+    m_context_popup.ApplySkin(m_ui.style());
+    m_status_bar.OnRightClick([this](POINT anchor) {
+      if (m_context_popup.IsOpen())
+        m_context_popup.HidePanel();
+      else
+        m_context_popup.ShowAt(anchor);
+    });
+  }
+
   int ret = m_server.Run();
 
   m_handler->Finalize();
+  if (m_popup.IsWindow())
+    m_popup.DestroyWindow();
+  if (m_context_popup.IsWindow())
+    m_context_popup.DestroyWindow();
+  if (m_status_bar.IsWindow())
+    m_status_bar.DestroyWindow();
   m_ui.Destroy();
   tray_icon.RemoveIcon();
   win_sparkle_cleanup();
