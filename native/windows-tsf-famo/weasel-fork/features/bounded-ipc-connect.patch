 void PipeChannelBase::_Receive(HANDLE pipe, LPVOID msg, size_t rec_len) {
-  DWORD lread;
-  BOOL success = ::ReadFile(pipe, msg, rec_len, &lread, NULL);
-  if (!success) {
-    _ThrowIfNot(ERROR_MORE_DATA);
+  if (rec_len == 0 || rec_len > 0xffffffffu) {
+    _ThrowCode(ERROR_INVALID_PARAMETER);
+  }

+  DWORD read_error = ERROR_SUCCESS;
+  DWORD lread =
+      FamoReadPipeBounded(pipe, msg, static_cast<DWORD>(rec_len), read_error);
+  if (read_error != ERROR_SUCCESS && read_error != ERROR_MORE_DATA) {
+    _ThrowCode(read_error);
+  }
+  if (lread < rec_len) {
+    _ThrowCode(ERROR_INVALID_DATA);
+  }
+
+  if (read_error == ERROR_MORE_DATA) {
     auto ctx = _GetContext();
     memset(ctx->buffer.get(), 0, buff_size);
-    success = ::ReadFile(pipe, ctx->buffer.get(), buff_size, &lread, NULL);
-    if (!success) {
-      _ThrowLastError;
+
+    DWORD body_error = ERROR_SUCCESS;
+    FamoReadPipeBounded(pipe, ctx->buffer.get(), static_cast<DWORD>(buff_size),
+                        body_error);
+    if (body_error != ERROR_SUCCESS) {
+      _ThrowCode(body_error == ERROR_MORE_DATA ? ERROR_INVALID_DATA
