+namespace {
+const DWORD kFamoPipeConnectBudgetMs = 1500;
+const DWORD kFamoPipeIoBudgetMs = 1500;
+
+struct ScopedEvent {
+  ScopedEvent() : handle(::CreateEvent(NULL, TRUE, FALSE, NULL)) {
+    if (!handle) {
+      _ThrowLastError;
+    }
+  }
+
+  ~ScopedEvent() {
+    if (handle) {
+      ::CloseHandle(handle);
+    }
+  }
+
+  HANDLE handle;
+};
+
+struct FamoPipeIoResult {
+  DWORD transferred = 0;
+  DWORD error = ERROR_SUCCESS;
+};
+
+FamoPipeIoResult FamoCancelPipeIoAndWait(HANDLE pipe,
+                                         OVERLAPPED& overlapped,
+                                         DWORD error_to_report) {
+  const BOOL cancelled = ::CancelIoEx(pipe, &overlapped);
+  const DWORD cancel_error = cancelled ? ERROR_SUCCESS : ::GetLastError();
+
+  // OVERLAPPED and its event are stack-owned.  They cannot be destroyed until
+  // the operation reaches a terminal state, even when cancellation races a
+  // natural completion (ERROR_NOT_FOUND).
+  DWORD transferred = 0;
+  if (::GetOverlappedResult(
+          pipe, &overlapped, &transferred, TRUE)) {
+    // Cancellation lost a race with natural completion. Reporting timeout
+    // here would make a fully delivered write retry (duplicate commit), or
+    // discard a response that the read already received.
+    return {transferred, ERROR_SUCCESS};
+  }
+  const DWORD completion_error = ::GetLastError();
+  if (completion_error == ERROR_MORE_DATA)
+    return {transferred, ERROR_MORE_DATA};
+  const bool expected_cancel =
+      completion_error == ERROR_OPERATION_ABORTED;
+  const bool completion_won_before_cancel =
+      cancel_error == ERROR_NOT_FOUND;
+  (void)expected_cancel;
+  (void)completion_won_before_cancel;
+  // The operation is terminal but did not naturally complete. Preserve the
+  // caller's timeout/wait diagnosis.
+  _ThrowCode(error_to_report);
+}
+
+DWORD FamoFinishPipeIo(HANDLE pipe, OVERLAPPED& overlapped, BOOL issued) {
+  if (!issued) {
+    DWORD err = ::GetLastError();
+    if (err != ERROR_IO_PENDING) {
+      _ThrowCode(err);
+    }
+
+    DWORD wait = ::WaitForSingleObject(overlapped.hEvent, kFamoPipeIoBudgetMs);
+    if (wait == WAIT_TIMEOUT) {
+      const FamoPipeIoResult completion =
+          FamoCancelPipeIoAndWait(
+              pipe, overlapped, ERROR_SEM_TIMEOUT);
+      if (completion.error != ERROR_SUCCESS)
+        _ThrowCode(completion.error);
+      return completion.transferred;
+    }
+    if (wait == WAIT_FAILED) {
+      const DWORD wait_error = ::GetLastError();
+      const FamoPipeIoResult completion =
+          FamoCancelPipeIoAndWait(pipe, overlapped, wait_error);
+      if (completion.error != ERROR_SUCCESS)
+        _ThrowCode(completion.error);
+      return completion.transferred;
+    }
+    if (wait != WAIT_OBJECT_0) {
+      const FamoPipeIoResult completion =
+          FamoCancelPipeIoAndWait(
+              pipe, overlapped, ERROR_INVALID_DATA);
+      if (completion.error != ERROR_SUCCESS)
+        _ThrowCode(completion.error);
+      return completion.transferred;
+    }
+  }
+
+  DWORD transferred = 0;
+  if (!::GetOverlappedResult(pipe, &overlapped, &transferred, FALSE)) {
+    _ThrowLastError;
+  }
+  return transferred;
+}
+
+DWORD FamoReadPipeBounded(HANDLE pipe, LPVOID msg, DWORD rec_len, DWORD& error) {
+  ScopedEvent event;
+  OVERLAPPED overlapped = {};
+  overlapped.hEvent = event.handle;
+
+  BOOL issued = ::ReadFile(pipe, msg, rec_len, NULL, &overlapped);
+  if (!issued) {
+    error = ::GetLastError();
+    if (error != ERROR_IO_PENDING) {
+      return error == ERROR_MORE_DATA ? rec_len : 0;
+    }
+
+    DWORD wait = ::WaitForSingleObject(overlapped.hEvent, kFamoPipeIoBudgetMs);
+    if (wait == WAIT_TIMEOUT) {
+      const FamoPipeIoResult completion =
+          FamoCancelPipeIoAndWait(
+              pipe, overlapped, ERROR_SEM_TIMEOUT);
+      error = completion.error;
+      return error == ERROR_MORE_DATA
+                 ? rec_len
+                 : completion.transferred;
+    }
+    if (wait == WAIT_FAILED) {
+      const DWORD wait_error = ::GetLastError();
+      const FamoPipeIoResult completion =
+          FamoCancelPipeIoAndWait(pipe, overlapped, wait_error);
+      error = completion.error;
+      return error == ERROR_MORE_DATA
+                 ? rec_len
+                 : completion.transferred;
+    }
+    if (wait != WAIT_OBJECT_0) {
+      const FamoPipeIoResult completion =
+          FamoCancelPipeIoAndWait(
+              pipe, overlapped, ERROR_INVALID_DATA);
+      error = completion.error;
+      return error == ERROR_MORE_DATA
+                 ? rec_len
+                 : completion.transferred;
+    }
+  }
+
+  DWORD transferred = 0;
+  if (!::GetOverlappedResult(pipe, &overlapped, &transferred, FALSE)) {
+    error = ::GetLastError();
+    return error == ERROR_MORE_DATA ? rec_len : 0;
+  }
+  error = ERROR_SUCCESS;
+  return transferred;
+}
