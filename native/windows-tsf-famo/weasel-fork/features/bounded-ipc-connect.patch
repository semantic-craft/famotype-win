+namespace {
+const DWORD kFamoPipeConnectBudgetMs = 1500;
+const DWORD kFamoPipeIoBudgetMs = 1500;
+
+struct ScopedEvent {
+  ScopedEvent() : handle(::CreateEvent(NULL, TRUE, FALSE, NULL)) {
+    if (!handle) {
+      _ThrowLastError;
+    }
+  }
+
+  ~ScopedEvent() {
+    if (handle) {
+      ::CloseHandle(handle);
+    }
+  }
+
+  HANDLE handle;
+};
+
+[[noreturn]] void FamoCancelPipeIoAndWait(HANDLE pipe,
+                                          OVERLAPPED& overlapped,
+                                          DWORD error_to_report) {
+  const BOOL cancelled = ::CancelIoEx(pipe, &overlapped);
+  const DWORD cancel_error = cancelled ? ERROR_SUCCESS : ::GetLastError();
+
+  // OVERLAPPED and its event are stack-owned.  They cannot be destroyed until
+  // the operation reaches a terminal state, even when cancellation races a
+  // natural completion (ERROR_NOT_FOUND).
+  DWORD transferred = 0;
+  if (!::GetOverlappedResult(pipe, &overlapped, &transferred, TRUE)) {
+    const DWORD completion_error = ::GetLastError();
+    const bool expected_terminal =
+        completion_error == ERROR_OPERATION_ABORTED ||
+        completion_error == ERROR_MORE_DATA ||
+        cancel_error == ERROR_NOT_FOUND;
+    (void)expected_terminal;
+    // The operation is terminal here; preserve the caller's timeout/wait
+    // diagnosis rather than exposing a secondary cancellation error.
+  }
+  _ThrowCode(error_to_report);
+}
+
+DWORD FamoFinishPipeIo(HANDLE pipe, OVERLAPPED& overlapped, BOOL issued) {
+  if (!issued) {
+    DWORD err = ::GetLastError();
+    if (err != ERROR_IO_PENDING) {
+      _ThrowCode(err);
+    }
+
+    DWORD wait = ::WaitForSingleObject(overlapped.hEvent, kFamoPipeIoBudgetMs);
+    if (wait == WAIT_TIMEOUT) {
+      FamoCancelPipeIoAndWait(pipe, overlapped, ERROR_SEM_TIMEOUT);
+    }
+    if (wait == WAIT_FAILED) {
+      const DWORD wait_error = ::GetLastError();
+      FamoCancelPipeIoAndWait(pipe, overlapped, wait_error);
+    }
+    if (wait != WAIT_OBJECT_0) {
+      FamoCancelPipeIoAndWait(pipe, overlapped, ERROR_INVALID_DATA);
+    }
+  }
+
+  DWORD transferred = 0;
+  if (!::GetOverlappedResult(pipe, &overlapped, &transferred, FALSE)) {
+    _ThrowLastError;
+  }
+  return transferred;
+}
+
+DWORD FamoReadPipeBounded(HANDLE pipe, LPVOID msg, DWORD rec_len, DWORD& error) {
+  ScopedEvent event;
+  OVERLAPPED overlapped = {};
+  overlapped.hEvent = event.handle;
+
+  BOOL issued = ::ReadFile(pipe, msg, rec_len, NULL, &overlapped);
+  if (!issued) {
+    error = ::GetLastError();
+    if (error != ERROR_IO_PENDING) {
+      return error == ERROR_MORE_DATA ? rec_len : 0;
+    }
+
+    DWORD wait = ::WaitForSingleObject(overlapped.hEvent, kFamoPipeIoBudgetMs);
+    if (wait == WAIT_TIMEOUT) {
+      FamoCancelPipeIoAndWait(pipe, overlapped, ERROR_SEM_TIMEOUT);
+    }
+    if (wait == WAIT_FAILED) {
+      const DWORD wait_error = ::GetLastError();
+      FamoCancelPipeIoAndWait(pipe, overlapped, wait_error);
+    }
+    if (wait != WAIT_OBJECT_0) {
+      FamoCancelPipeIoAndWait(pipe, overlapped, ERROR_INVALID_DATA);
+    }
+  }
+
+  DWORD transferred = 0;
+  if (!::GetOverlappedResult(pipe, &overlapped, &transferred, FALSE)) {
+    error = ::GetLastError();
+    return error == ERROR_MORE_DATA ? rec_len : 0;
+  }
+  error = ERROR_SUCCESS;
+  return transferred;
+}
+}  // namespace
