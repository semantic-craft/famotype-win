+RimeWithWeaselHandler::AbiActionOutcome
+RimeWithWeaselHandler::_ExecuteAbiAction(
+    WeaselSessionId ipc_id,
+    SessionStatus* session_status,
+    FamoEngineActionRequestV2 request,
+    EatLine eat) {
+  AbiActionOutcome result;
+  if (!session_status || !session_status->engine_ctx)
+    return result;
+
+  constexpr uint32_t kMaxViewCandidates = 4096u;
+  constexpr uint32_t kMaxPendingResponseStringBytes = 1024u * 1024u;
+  static_assert(
+      std::is_nothrow_move_assignable<
+          FamoEngineActionResultLease>::value,
+      "pending response adoption must not allocate or throw");
+
+  // A previously finalized result owns the only undelivered commit. Return it
+  // in this transaction and do not dispatch the new physical/control action.
+  // The caller formats it once; the new action fails open/fails.
+  if (session_status->pending_response_result) {
+    result.ready = true;
+    result.recovered_prior = true;
+    return result;
+  }
+
+  if (session_status->pending_recovery_action != 0) {
+    const uint32_t original_action =
+        session_status->pending_recovery_action;
+    FamoEngineActionRequestV2 recovery =
+        FamoEngineHost::Action(FAMO_ENGINE_ACTION_RECOVER);
+    recovery.value = static_cast<int32_t>(original_action);
+    bool recovered = false;
+    for (uint32_t attempt = 0; attempt < 3u; ++attempt) {
+      if (m_engine_host.ExecuteAction(session_status->engine_ctx, &recovery,
+                                      &m_abi_result) == FAMO_ENGINE_OK &&
+          m_abi_result &&
+          FamoEngineHost::ValidateResultV2(
+              m_abi_result.get(), original_action, kMaxViewCandidates,
+              kMaxPendingResponseStringBytes) &&
+          m_abi_result->result_flags == 0 &&
+          (m_abi_result->handled != 0) ==
+              session_status->pending_recovery_handled) {
+        recovered = true;
+        break;
+      }
+      (void)m_abi_result.Reset();
+    }
+    if (!recovered) {
+      result.recovered_prior = true;
+      // The current physical input never entered the engine. Do not retain it
+      // waiting for another user event: fail open in this callback.
+      result.handled = false;
+      return result;
+    }
+    // Adopt the engine-owned final result before clearing the receipt state or
+    // performing any formatting allocation. A bad_alloc/sink failure can now
+    // retry serialization without ever issuing RECOVER twice.
+    session_status->pending_response_result = std::move(m_abi_result);
+    session_status->pending_recovery_action = 0;
+    session_status->pending_recovery_handled = false;
+    result.ready = true;
+    result.recovered_prior = true;
+    return result;
+  }
+
+  FamoEngineRecoveryOutcome recovery_outcome;
+  const int32_t execute_result = m_engine_host.ExecuteActionRecovering(
+      session_status->engine_ctx, &request, 3u, &m_abi_result,
+      &recovery_outcome);
+  result.business_dispatched = recovery_outcome.business_dispatched;
+  result.handled = recovery_outcome.handled;
+  if (execute_result != FAMO_ENGINE_OK || !m_abi_result) {
+    if (recovery_outcome.recovery_pending) {
+      session_status->pending_recovery_action = request.action;
+      session_status->pending_recovery_handled =
+          recovery_outcome.handled;
+    }
+    (void)m_abi_result.Reset();
+    return result;
+  }
+  if (!FamoEngineHost::ValidateResultV2(
+          m_abi_result.get(), request.action, kMaxViewCandidates,
+          kMaxPendingResponseStringBytes) ||
+      m_abi_result->result_flags != 0) {
+    (void)m_abi_result.Reset();
+    return result;
+  }
+  session_status->pending_response_result = std::move(m_abi_result);
+  result.ready = true;
+  result.handled =
+      session_status->pending_response_result->handled != 0;
+  return result;
+}
+
+// STATUS 是显式只读 action，不消费 commit；结果仍经同一 v2 validator。
+bool RimeWithWeaselHandler::_RefillAbiView(FamoEngineContext* ctx) {
+  if (!ctx)
+    return false;
+  for (const auto& entry : m_session_status_map) {
+    if (entry.second.engine_ctx == ctx &&
+        (entry.second.pending_recovery_action != 0 ||
+         entry.second.pending_response_result)) {
+      return false;
+    }
+  }
+  FamoEngineActionRequestV2 status =
+      FamoEngineHost::Action(FAMO_ENGINE_ACTION_STATUS);
+  if (m_engine_host.ExecuteAction(ctx, &status, &m_abi_result) !=
+          FAMO_ENGINE_OK ||
+      !m_abi_result ||
+      !FamoEngineHost::ValidateResultV2(
+          m_abi_result.get(), status.action, 4096u, 1024u * 1024u) ||
+      m_abi_result->result_flags != 0) {
+    (void)m_abi_result.Reset();
+    return false;
+  }
+  return true;
+}
+
+void RimeWithWeaselHandler::_DestroyAbiContexts() {
+  // ABI lifecycle order is strict: result -> contexts -> shutdown/unload.
+  (void)m_abi_result.Reset();
+  m_staged_response_delivery = {};
+  if (m_engine_host.V2Runnable()) {
+    for (auto& pair : m_session_status_map) {
+      (void)pair.second.pending_response_result.Reset();
+      if (pair.second.engine_ctx) {
+        (void)_DestroyEngineContext(pair.second.engine_ctx);
+        pair.second.engine_ctx = nullptr;
+        pair.second.engine_generation = 0;
+      }
+    }
+  }
+  m_session_status_map.clear();
+  _ClearNotifications();
 }
 
