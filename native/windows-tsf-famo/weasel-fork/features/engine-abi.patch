+bool FamoParseDword(const wchar_t* begin,
+                    const wchar_t* end,
+                    DWORD* value) noexcept {
+  if (!begin || !end || !value || begin == end)
+    return false;
+  unsigned long long parsed = 0;
+  for (const wchar_t* current = begin; current != end; ++current) {
+    if (*current < L'0' || *current > L'9')
+      return false;
+    parsed = parsed * 10u + static_cast<unsigned>(*current - L'0');
+    if (parsed > MAXDWORD)
+      return false;
+  }
+  *value = static_cast<DWORD>(parsed);
+  return true;
+}
