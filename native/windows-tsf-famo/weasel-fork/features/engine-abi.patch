+bool RimeWithWeaselHandler::_BindNotificationContext(
+    FamoEngineContext* engine_ctx,
+    WeaselSessionId ipc_id,
+    uint64_t* out_generation) noexcept {
+  if (out_generation)
+    *out_generation = 0;
+  if (!engine_ctx || !ipc_id || !out_generation)
+    return false;
+  try {
+    std::lock_guard<std::mutex> lock(m_notifier_mutex);
+    if (m_notification_targets.find(engine_ctx) !=
+        m_notification_targets.end())
+      return false;
+    const uint64_t generation = m_next_notification_generation;
+    if (!generation || generation == UINT64_MAX)
+      return false;
+    const EngineNotificationKey key(ipc_id, generation);
+    const auto target =
+        m_notification_targets.emplace(
+            engine_ctx, EngineNotificationTarget{ipc_id, generation});
+    if (!target.second)
+      return false;
+    try {
+      const auto queue = m_session_notifications.try_emplace(key);
+      if (!queue.second) {
+        m_notification_targets.erase(target.first);
+        return false;
+      }
+      const auto unbound = m_unbound_notifications.find(engine_ctx);
+      if (unbound != m_unbound_notifications.end()) {
+        queue.first->second.swap(unbound->second);
+        m_unbound_notifications.erase(unbound);
+      }
+    } catch (...) {
+      m_notification_targets.erase(target.first);
+      throw;
+    }
+    ++m_next_notification_generation;
+    *out_generation = generation;
+    return true;
+  } catch (...) {
+    return false;
+  }
+}
+
+void RimeWithWeaselHandler::_ForgetNotificationContext(
+    FamoEngineContext* engine_ctx) noexcept {
+  if (!engine_ctx)
+    return;
+  try {
+    std::lock_guard<std::mutex> lock(m_notifier_mutex);
+    const auto target = m_notification_targets.find(engine_ctx);
+    if (target != m_notification_targets.end()) {
+      m_session_notifications.erase(
+          EngineNotificationKey(target->second.ipc_id,
+                                target->second.generation));
+      m_notification_targets.erase(target);
+    }
+    m_unbound_notifications.erase(engine_ctx);
+  } catch (...) {
+  }
+}
+
+void RimeWithWeaselHandler::_ClearNotifications() noexcept {
+  try {
+    std::lock_guard<std::mutex> lock(m_notifier_mutex);
+    m_notification_targets.clear();
+    m_unbound_notifications.clear();
+    m_session_notifications.clear();
+    m_global_notifications.clear();
+    m_next_notification_generation = 1;
+  } catch (...) {
+  }
+}
+
+bool RimeWithWeaselHandler::_TakeNotification(
+    FamoEngineContext* engine_ctx,
+    uint64_t engine_generation,
+    PendingEngineNotification* out) noexcept {
+  if (!out)
+    return false;
+  try {
+    std::lock_guard<std::mutex> lock(m_notifier_mutex);
+    if (engine_ctx && engine_generation) {
+      const auto target = m_notification_targets.find(engine_ctx);
+      if (target != m_notification_targets.end() &&
+          target->second.generation == engine_generation) {
+        const EngineNotificationKey key(target->second.ipc_id,
+                                        target->second.generation);
+        const auto queue = m_session_notifications.find(key);
+        if (queue != m_session_notifications.end() &&
+            !queue->second.empty()) {
+          *out = std::move(queue->second.front());
+          queue->second.pop_front();
+          return true;
+        }
+      }
+    }
+    if (!m_global_notifications.empty()) {
+      *out = std::move(m_global_notifications.front());
+      m_global_notifications.pop_front();
+      return true;
+    }
+  } catch (...) {
+  }
+  return false;
+}
+
+int32_t RimeWithWeaselHandler::_DestroyEngineContext(
+    FamoEngineContext* engine_ctx) noexcept {
+  if (!engine_ctx)
+    return FAMO_ENGINE_E_INVALID_ARGUMENT;
+  int32_t result = FAMO_ENGINE_E_RUNTIME;
+  try {
+    // Never hold m_notifier_mutex while entering the engine: DestroyContext
+    // may wait for an OnNotify callback that is currently taking that mutex.
+    result = m_engine_host.DestroyContext(engine_ctx);
+  } catch (...) {
+  }
+  _ForgetNotificationContext(engine_ctx);
+  return result;
+}
 
