+      // Echo/reconnect through it: Disconnect would END the logical session
+      // and destroy the only retained commit. Applied envelopes may ACK here
+      // because this method runs outside a TSF edit lock.
+      if (!m_client.ResponseDataApplied())
+        return false;
+      return m_client.AcknowledgeResponseData();
+    }
+    if (m_client.Echo())
+      return true;
+
+    (void)_Reconnect();
+    retry++;
+    if (retry >= 6) {
+      HANDLE hMutex =
+          CreateMutex(NULL, TRUE, L"WeaselDeployerExclusiveMutex");
+      try {
+        const auto count_server_process = []() -> int {
+          int count = 0;
+          HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+          if (snap == INVALID_HANDLE_VALUE)
+            return 0;
+          PROCESSENTRY32 pe;
+          pe.dwSize = sizeof(pe);
+          if (Process32First(snap, &pe)) {
+            do {
+              if (_wcsicmp(pe.szExeFile, L"WeaselServer.exe") == 0)
+                count++;
+            } while (Process32Next(snap, &pe));
+          }
+          CloseHandle(snap);
+          return count;
+        };
+        if (!m_client.Echo() &&
+            GetLastError() != ERROR_ALREADY_EXISTS &&
+            !count_server_process()) {
+          const std::wstring dir = _GetRootDir();
+          // ShellExecute returns after launching. A detached std::thread adds
+          // allocation/system_error and lifetime failure modes here.
+          (void)ShellExecuteW(
+              NULL, L"open", (dir + L"\\start_service.bat").c_str(),
+              NULL, dir.c_str(), SW_HIDE);
+        }
+      } catch (...) {
+        if (hMutex)
+          CloseHandle(hMutex);
+        throw;
+      }
+      if (hMutex)
+        CloseHandle(hMutex);
+      retry = 0;
+    }
+    return (m_client.Echo() != 0);
+  } catch (...) {
+    return false;
+  }
+}
