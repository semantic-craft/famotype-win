+void test_5() {
+  WCHAR resp[] =
+      L"action=commit\n"
+      L"commit=旧\n"
+      L".\n"
+      L"action=commit\n"
+      L"commit=新\n"
+      L".\n";
+  DWORD len = static_cast<DWORD>(wcslen(resp));
+  std::wstring commit;
+  weasel::Context ctx;
+  weasel::Status status;
+  weasel::ResponseParser parser(&commit, &ctx, &status);
+  BOOST_TEST(parser(resp, len));
+  BOOST_TEST(commit == L"旧新");
+}
+
+void test_6() {
+  // A failed second response must not partially overwrite the first complete
+  // document already buffered for this transaction.
+  weasel::PipeChannel<DWORD> channel(std::wstring(L"unused"), nullptr, 128);
+  const std::wstring first =
+      L"action=commit\n"
+      L"commit=旧\n"
+      L".\n";
+  BOOST_TEST(channel.TryWrite(first));
+  BOOST_TEST(!channel.TryWrite(std::wstring(64, L'x')));
+  const auto* stored =
+      reinterpret_cast<const wchar_t*>(channel.SendBuffer());
+  BOOST_TEST(std::wstring(stored, first.size()) == first);
+}
+
 int _tmain(int argc, _TCHAR* argv[]) {
