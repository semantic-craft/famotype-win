+// 法墨引擎 ABI：把 std::string 包成栈上 FamoUtf8String（生命周期不超过被调 op）。
+static inline FamoUtf8String FamoU8(const std::string& s) {
+  FamoUtf8String u;
+  u.size = (uint32_t)sizeof(FamoUtf8String);
+  u.data = s.c_str();
+  u.length_bytes = (uint32_t)s.size();
+  return u;
+}
+
+static inline std::string FamoString(const FamoUtf8String& value) {
+  return value.length_bytes && value.data
+             ? std::string(value.data, value.length_bytes)
+             : std::string();
+}
+
+static inline std::wstring FamoWide(const FamoUtf8String& value) {
+  return u8tow(FamoString(value));
+}
