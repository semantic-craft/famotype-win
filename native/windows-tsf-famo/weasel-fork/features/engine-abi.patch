+bool RimeWithWeaselHandler::_RefillAbiView(FamoEngineContext* ctx) {
+  if (m_abi_view_valid) {
+    m_engine_host.FreeView(&m_abi_view);
+    m_abi_view_valid = false;
+  }
+  if (!ctx)
+    return false;
