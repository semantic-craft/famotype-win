+DWORD _ReadSessionCreationNonce(LPWSTR buffer) {
+  if (!buffer)
+    return 0;
+  constexpr wchar_t kPrefix[] = L"session.creation_nonce=";
+  wbufferstream stream(buffer, WEASEL_IPC_BUFFER_LENGTH);
+  std::wstring line;
+  while (stream.good()) {
+    std::getline(stream, line);
+    if (!stream.good() || line == L".")
+      break;
+    if (!starts_with(line, std::wstring(kPrefix)))
+      continue;
+    const wchar_t* begin = line.c_str() + std::size(kPrefix) - 1;
+    wchar_t* end = nullptr;
+    const unsigned long parsed = std::wcstoul(begin, &end, 10);
+    if (begin != end && end && *end == L'\0' &&
+        parsed != 0 && parsed <= MAXDWORD) {
+      return static_cast<DWORD>(parsed);
+    }
+    return 0;
+  }
+  return 0;
+}
