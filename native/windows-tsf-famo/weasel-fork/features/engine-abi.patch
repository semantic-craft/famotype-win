+namespace {
+ULONGLONG FamoFileTimeValue(const FILETIME& value) noexcept {
+  ULARGE_INTEGER combined{};
+  combined.LowPart = value.dwLowDateTime;
+  combined.HighPart = value.dwHighDateTime;
+  return combined.QuadPart;
+}
+
+ULONGLONG FamoQueryProcessCreationTime(DWORD process_id) noexcept {
+  if (process_id == 0)
+    return 0;
+  HANDLE process = ::OpenProcess(
+      PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE, FALSE, process_id);
+  if (!process)
+    return 0;
+  FILETIME created{}, exited{}, kernel{}, user{};
+  const BOOL queried =
+      ::GetProcessTimes(process, &created, &exited, &kernel, &user);
+  ::CloseHandle(process);
+  return queried ? FamoFileTimeValue(created) : 0;
+}
+
+bool FamoObservedClientIsAlive(DWORD process_id,
+                               ULONGLONG created_at) noexcept {
+  // Sessions created by an older server/client pair have no observation.
+  // Keep them rather than guessing across a rolling update.
+  if (process_id == 0 || created_at == 0)
+    return true;
+
+  HANDLE process = ::OpenProcess(
+      PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE, FALSE, process_id);
+  if (!process)
+    return ::GetLastError() != ERROR_INVALID_PARAMETER;
+
+  const DWORD wait = ::WaitForSingleObject(process, 0);
+  if (wait == WAIT_OBJECT_0) {
+    ::CloseHandle(process);
+    return false;
+  }
+
+  FILETIME created{}, exited{}, kernel{}, user{};
+  const BOOL queried =
+      ::GetProcessTimes(process, &created, &exited, &kernel, &user);
+  ::CloseHandle(process);
+  if (!queried)
+    return true;
+  return FamoFileTimeValue(created) == created_at;
+}
