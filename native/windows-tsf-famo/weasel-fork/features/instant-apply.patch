+void RimeWithWeaselHandler::_ApplyFamoStyleOverlay(RimeConfig* base) {
+  // 法墨即时外观②：把 famo-style.yaml 覆盖层叠加到 m_ui->style() 之上。
+  // base 已含 preset_color_schemes（已编译 weasel.yaml），用于按名套皮肤。
+  if (!m_ui)
+    return;
+  std::string yaml = _ReadFamoStyleOverlayYaml();
+  if (yaml.empty())
+    return;
+  RimeConfig overlay = {NULL};
+  if (!rime_api->config_init(&overlay))
+    return;
+  if (rime_api->config_load_string(&overlay, yaml.c_str())) {
+    // initialize=false ⇒ 仅覆盖覆盖层中出现的标量键，其余保持 base。
+    _UpdateUIStyle(&overlay, m_ui, false);
+    // 皮肤：覆盖层给出 color_scheme(_dark) 时按名套用，preset 取自 base。
+    const int BUF_SIZE = 255;
+    char buffer[BUF_SIZE + 1] = {0};
+    const char* key =
+        m_current_dark_mode ? "style/color_scheme_dark" : "style/color_scheme";
+    if (rime_api->config_get_string(&overlay, key, buffer, BUF_SIZE) &&
+        buffer[0]) {
+      _UpdateUIStyleColor(base, m_ui->style(), std::string(buffer));
+    }
+  }
+  rime_api->config_close(&overlay);
+}
+
+void RimeWithWeaselHandler::ReloadStyleOverlay(WeaselSessionId ipc_id,
+                                               EatLine eat) {
+  // 法墨即时外观②：重读 base(weasel.yaml) + famo-style.yaml 覆盖层，刷新所有会话样式。
+  // 复用 UpdateColorTheme 的传播逻辑；不部署、不重建 prism、不碰 TSF 热路径。
+  LOG(INFO) << "Famo: ReloadStyleOverlay (instant style, no deploy).";
+  RimeConfig config = {NULL};
+  if (rime_api->config_open("weasel", &config)) {
+    if (m_ui) {
+      _UpdateUIStyle(&config, m_ui, true);
+      if (m_current_dark_mode) {
+        const int BUF_SIZE = 255;
+        char buffer[BUF_SIZE + 1] = {0};
+        if (rime_api->config_get_string(&config, "style/color_scheme_dark",
+                                        buffer, BUF_SIZE)) {
+          std::string color_name(buffer);
+          _UpdateUIStyleColor(&config, m_ui->style(), color_name);
+        }
+      }
+      _ApplyFamoStyleOverlay(&config);
+      m_base_style = m_ui->style();
+    }
+    rime_api->config_close(&config);
+  }
+
+  for (auto& pair : m_session_status_map) {
+    RIME_STRUCT(RimeStatus, status);
+    if (rime_api->get_status(to_session_id(pair.first), &status)) {
+      pair.second.style = m_base_style;
+      _LoadSchemaSpecificSettings(pair.first, std::string(status.schema_id));
+      _LoadAppInlinePreeditSet(pair.first, true);
+      _UpdateInlinePreeditStatus(pair.first);
+      pair.second.status = status;
+      pair.second.__synced = false;
+      rime_api->free_status(&status);
+    }
+  }
+  if (m_active_session) {
+    m_ui->style() = get_session_status(m_active_session).style;
+    _UpdateUI(m_active_session);
+  }
+  if (ipc_id && eat && m_session_status_map.find(ipc_id) != m_session_status_map.end())
+    _Respond(ipc_id, eat);
+}
+
+void RimeWithWeaselHandler::_ApplyFamoOptions(RimeSessionId session_id) {
+  // 法墨即时开关①：把 famo-options.yaml 的 options: 映射逐项 set_option 到一个会话。
+  std::string yaml = _ReadFamoFile(L"famo-options.yaml");
+  if (yaml.empty())
+    return;
+  RimeConfig cfg = {NULL};
+  if (!rime_api->config_init(&cfg))
+    return;
+  if (rime_api->config_load_string(&cfg, yaml.c_str())) {
+    RimeConfigIterator it = {0};
+    if (rime_api->config_begin_map(&it, &cfg, "options")) {
+      while (rime_api->config_next(&it)) {
+        Bool v = False;
+        if (rime_api->config_get_bool(&cfg, it.path, &v))
+          rime_api->set_option(session_id, it.key, !!v);
+      }
+      rime_api->config_end(&it);
+    }
+  }
+  rime_api->config_close(&cfg);
+}
+
+void RimeWithWeaselHandler::ReloadOptions() {
+  // 法墨即时开关①：重读 famo-options.yaml，set_option 到所有活动会话（不部署、不重建 prism）。
+  LOG(INFO) << "Famo: ReloadOptions (instant switches, no deploy).";
+  if (m_disabled)
+    return;
+  for (auto& pair : m_session_status_map)
+    _ApplyFamoOptions(to_session_id(pair.first));
+  if (m_active_session)
+    _UpdateUI(m_active_session);  // 中英/简繁等状态变化即时反映到候选窗/状态栏
+}
