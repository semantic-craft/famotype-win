+bool CCandidateList::_ReadStyleFileTime(FILETIME* ft) {
+  wchar_t base[MAX_PATH] = {0};
+  DWORD len = GetEnvironmentVariableW(L"LOCALAPPDATA", base, MAX_PATH);
+  if (!len || len >= MAX_PATH)
+    return false;
+  std::wstring path(base);
+  path.append(L"\\Famo\\famo-style.yaml");
+  WIN32_FILE_ATTRIBUTE_DATA data = {};
+  if (!GetFileAttributesExW(path.c_str(), GetFileExInfoStandard, &data))
+    return false;
+  *ft = data.ftLastWriteTime;
+  return true;
+}
+
+void CCandidateList::_StartStylePoll() {
+  if (_style_polling)
+    return;
+  _ReadStyleFileTime(&_style_mtime);
+  if (SetTimer(NULL, reinterpret_cast<UINT_PTR>(this), 500,
+               &CCandidateList::_StylePollTimerProc)) {
+    _style_polling = true;
+  }
+}
+
+void CCandidateList::_StopStylePoll() {
+  if (!_style_polling)
+    return;
+  KillTimer(NULL, reinterpret_cast<UINT_PTR>(this));
+  _style_polling = false;
+}
+
+void CCandidateList::_PollStyleFile() {
+  FILETIME ft = {};
+  if (!_ReadStyleFileTime(&ft))
+    return;
+  if (CompareFileTime(&ft, &_style_mtime) == 0)
+    return;
+  _style_mtime = ft;
+  _tsf->_ReloadStyleFromServerForCandidate();
+}
+
+VOID CALLBACK CCandidateList::_StylePollTimerProc(HWND,
+                                                  UINT,
+                                                  UINT_PTR id,
+                                                  DWORD) {
+  reinterpret_cast<CCandidateList*>(id)->_PollStyleFile();
+}
