+FamoCompositionView WeaselPanel::_FamoViewFromContext(
+    const weasel::Context& ctx,
+    const weasel::Status& status,
+    std::vector<FamoCandidate>& out_cands,
+    std::vector<std::string>& out_u8) const {
+  const auto& cands = ctx.cinfo.candies;
+  const size_t n = cands.size();
+  // 先把所有串填进 out_u8（预留容量，避免 realloc 让 FamoCandidate 内指针失效），
+  // 再据稳定的 out_u8 建 out_cands。out_u8 布局：[0]=preedit，之后每候选 text/comment/label。
+  out_u8.clear();
+  out_u8.reserve(n * 3 + 2);
+  // inline_preedit 开启时 preedit 已由 app 内联显示（下划线预编辑串），候选窗不再重复画，
+  // 与 stock 面板一致（S22 真机：否则弹窗顶部重复画 "ni hao" 且与候选行重叠）。
+  out_u8.push_back(m_style.inline_preedit ? std::string() : wtou8(ctx.preedit.str));  // [0] preedit
+  for (size_t i = 0; i < n; ++i) {
+    out_u8.push_back(wtou8(cands[i].str));                                   // text
+    out_u8.push_back(i < ctx.cinfo.comments.size() ? wtou8(ctx.cinfo.comments[i].str) : std::string());
+    out_u8.push_back(i < ctx.cinfo.labels.size() ? wtou8(ctx.cinfo.labels[i].str) : std::string());
+  }
+  auto u8str = [](const std::string& s) {
+    FamoUtf8String u;
+    u.size = (uint32_t)sizeof(FamoUtf8String);
+    u.data = s.empty() ? nullptr : s.c_str();
+    u.length_bytes = (uint32_t)s.size();
+    return u;
+  };
+  out_cands.clear();
+  out_cands.resize(n);
+  for (size_t i = 0; i < n; ++i) {
+    FamoCandidate& c = out_cands[i];
+    c = FamoCandidate{};
+    c.size = (uint32_t)sizeof(FamoCandidate);
+    c.text = u8str(out_u8[1 + i * 3 + 0]);
+    c.comment = u8str(out_u8[1 + i * 3 + 1]);
+    c.label = u8str(out_u8[1 + i * 3 + 2]);
+  }
+  FamoCompositionView v{};
+  v.size = (uint32_t)sizeof(FamoCompositionView);
+  v.preedit = u8str(out_u8[0]);
+  v.candidates = out_cands.empty() ? nullptr : out_cands.data();
+  v.candidate_count = (uint32_t)n;
+  v.highlighted_index = ctx.cinfo.highlighted;
+  v.page_index = ctx.cinfo.currentPage;
+  v.is_last_page = ctx.cinfo.is_last_page ? 1u : 0u;
+  if (status.ascii_mode)
+    v.status_flags |= FAMO_STATUS_ASCII_MODE;
+  if (status.composing)
+    v.status_flags |= FAMO_STATUS_COMPOSING;
+  if (status.disabled)
+    v.status_flags |= FAMO_STATUS_DISABLED;
+  if (status.full_shape)
+    v.status_flags |= FAMO_STATUS_FULL_SHAPE;
+  // 软光标选区（item 2）：ctx.preedit.attributes 的 HIGHLIGHTED 段是正在转换的子串，
+  // 其 range.start/end 为 wchar 偏移；view 要的是 preedit UTF-8 串（out_u8[0]）内的字节偏移，
+  // 组件 layout 再 FamoUtf8ByteToWchar 转回渲染。inline_preedit 时 preedit 喂空 → 偏移留 0
+  // （软光标只在非 inline 场景可见，与 stock 面板一致）。
+  if (!m_style.inline_preedit) {
+    const std::wstring& p = ctx.preedit.str;
+    const int wl = (int)p.size();
+    for (const auto& attr : ctx.preedit.attributes) {
+      if (attr.type != weasel::HIGHLIGHTED)
+        continue;
+      int ws = attr.range.start < 0 ? 0 : (attr.range.start > wl ? wl : attr.range.start);
+      int we = attr.range.end < ws ? ws : (attr.range.end > wl ? wl : attr.range.end);
+      v.preedit_sel_start = (uint32_t)wtou8(p.substr(0, ws)).size();
+      v.preedit_sel_end = (uint32_t)wtou8(p.substr(0, we)).size();
+      break;  // first HIGHLIGHTED range drives the soft cursor
+    }
   }
+  return v;
+}
+
+void WeaselPanel::_FamoEnsureTextRes(const FamoSkin& skin, UINT effective_dpi) {
+  // 逐键复用；dpi 变（WM_DPICHANGED）或字体（族/字号）变时重建。换 color scheme 只改颜色
+  // 不必重建——颜色每帧从 FamoSkin 读；但若 scheme 也改了字体，res 缓存的三档 DirectWrite
+  // 格式会过时（item 5）。指纹只比 res 真正缓存的三档字体（FamoFontSpec 尾部经 FamoSkin 零初始
+  // 化，memcmp 稳定）。
+  const FamoFontSpec fonts[3] = {skin.label_font, skin.text_font, skin.comment_font};
+  const bool fonts_same =
+      m_famo_res && memcmp(m_famo_res_fonts, fonts, sizeof(fonts)) == 0;
+  if (m_famo_res && m_famo_res_dpi == effective_dpi && fonts_same)
+    return;
+  if (m_famo_res) {
+    FamoTextResourcesDestroy(m_famo_res);
+    m_famo_res = nullptr;
+  }
+  m_famo_res = FamoTextResourcesCreate(&skin, effective_dpi);
+  m_famo_res_dpi = effective_dpi;
+  memcpy(m_famo_res_fonts, fonts, sizeof(fonts));
+}
