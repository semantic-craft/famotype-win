+  k.text_color = (uint32_t)s.text_color;
+  k.back_color = (uint32_t)s.back_color;
+  k.border_color = (uint32_t)s.border_color;
+  k.hilited_text_color = (uint32_t)s.hilited_candidate_text_color;
+  k.hilited_back_color = (uint32_t)s.hilited_candidate_back_color;
+  k.candidate_text_color = (uint32_t)s.candidate_text_color;
+  k.label_color = (uint32_t)s.label_text_color;
+  k.comment_color = (uint32_t)s.comment_text_color;
+  k.hilited_comment_color = (uint32_t)s.hilited_comment_text_color;
+  k.prevpage_color = (uint32_t)s.prevpage_color;
+  k.nextpage_color = (uint32_t)s.nextpage_color;
+  k.shadow_color = (uint32_t)s.shadow_color;
+  // 字体：label/text/comment 三档。
+  _FamoFillFace(k.label_font, s.label_font_face, s.label_font_point);
+  _FamoFillFace(k.text_font, s.font_face, s.font_point);
+  _FamoFillFace(k.comment_font, s.comment_font_face, s.comment_font_point);
+  // 度量（logical px @96dpi；组件按 dpi/96 缩放）。
+  k.margin_x = s.margin_x;
+  k.margin_y = s.margin_y;
+  k.spacing = s.spacing;
+  k.candidate_spacing = s.candidate_spacing;
+  k.hilite_padding_x = s.hilite_padding_x;
+  k.hilite_padding_y = s.hilite_padding_y;
