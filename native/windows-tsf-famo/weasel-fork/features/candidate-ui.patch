+CRect WeaselPanel::_FamoHitRect(const FamoRect& r) const {
+  // 组件 rect 是 content 坐标（原点 content 左上）；窗口把 content 画在 (sm,sm)，故 client
+  // 坐标 = rect + shadow_margin。空 rect（如无翻页 affordance）平移后仍为空 → PtInRect 假。
+  const int sm = m_famo_layout.shadow_margin > 0 ? m_famo_layout.shadow_margin : 0;
+  return CRect(r.left + sm, r.top + sm, r.right + sm, r.bottom + sm);
+}
