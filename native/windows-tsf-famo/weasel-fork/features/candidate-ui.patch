+  FamoLayoutInput input{};
+  input.size = (uint32_t)sizeof(FamoLayoutInput);
+  input.caret_rect = {m_inputPos.left, m_inputPos.top, m_inputPos.right,
+                      m_inputPos.bottom};
+  input.work_area = {work.left, work.top, work.right, work.bottom};
+  input.dpi = dpi;
+  input.aux.size = (uint32_t)sizeof(FamoUtf8String);
+  input.aux.data = aux_u8.empty() ? nullptr : aux_u8.c_str();
+  input.aux.length_bytes = (uint32_t)aux_u8.size();
+  input.measure = &FamoTextMeasure;
+  input.measure_user = m_famo_res;
+
+  m_famo_layout = FamoLayoutResult{};
+  m_famo_layout.size = (uint32_t)sizeof(FamoLayoutResult);
+  if (FamoCandidateUiLayout(&view, &skin, &input, &m_famo_layout) != FAMO_UI_OK)
+    return false;
+  // host 端 sticky 反抖动叠加在组件 flip 之上（一旦上翻保持上翻，直到 MoveTo 判定重置）。
+  if (m_sticky)
+    m_famo_layout.flipped = 1;
+
+  // 位图 = content + 2*shadow_margin（item 1）：组件 layout 算出 shadow_margin，PaintImpl 把
+  // content 画在 (sm,sm)、高斯阴影画在四周 sm 环内。窗口置于 (origin - sm)，使 content 仍落在
+  // caret 锚定的 origin（阴影只是向外扩边，不移动内容）。sm==0（皮肤无阴影）时退化为原尺寸。
+  const int sm = m_famo_layout.shadow_margin > 0 ? m_famo_layout.shadow_margin : 0;
+  int w = m_famo_layout.content_size.cx + 2 * sm;
+  int h = m_famo_layout.content_size.cy + 2 * sm;
+  SetWindowPos(HWND_TOPMOST, m_famo_layout.origin_x - sm, m_famo_layout.origin_y - sm,
+               w, h, SWP_NOACTIVATE | SWP_NOREDRAW);
+  GetClientRect(&rcw);  // 刷新 client 矩形（鼠标 hit-test/capture/invalidate 用；item 3/6）
 
-  // offsetx for font glyph over left
-  float offsetx = (float)rc.left;
-  float offsety = (float)rc.top;
-  // prepare for space when first character overhanged
-  DWRITE_OVERHANG_METRICS omt;
-  HR(pDWR->GetLayoutOverhangMetrics(&omt));
-  if (m_style.layout_type != UIStyle::LAYOUT_VERTICAL_TEXT && omt.left > 0)
-    offsetx += omt.left;
-  if (m_style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT && omt.top > 0)
-    offsety += omt.top;
+  CDCHandle hdc = ::GetDC(m_hWnd);
+  CDCHandle memDC = ::CreateCompatibleDC(hdc);
+  // 中立组件把 GDI+ 画进位图原始 premultiplied 缓冲（bmBits）→ 必须是 32-bit top-down DIB
+  // section。CreateCompatibleBitmap 给的是 DDB（无 bmBits）→ PaintImpl 的 DIBSECTION 校验失败、
+  // 直接返回错误、整窗从不绘制（层窗 ULW_ALPHA 下 = 全透明不可见）。见 famo_paint.cpp 的 32-bit DIB 校验。
+  BITMAPINFO bmi = {};
+  bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+  bmi.bmiHeader.biWidth = w;
+  bmi.bmiHeader.biHeight = -h;  // top-down
+  bmi.bmiHeader.biPlanes = 1;
+  bmi.bmiHeader.biBitCount = 32;
+  bmi.bmiHeader.biCompression = BI_RGB;
+  void* bits = nullptr;
+  HBITMAP memBitmap = ::CreateDIBSection(hdc, &bmi, DIB_RGB_COLORS, &bits, NULL, 0);
+  ::SelectObject(memDC, memBitmap);
+  ReleaseDC(hdc);
 
-  if (pDWR->pTextLayout != NULL) {
-    pDWR->DrawTextLayoutAt({offsetx, offsety});
-#if 0
-    D2D1_RECT_F rectf =  D2D1::RectF(offsetx, offsety, offsetx + rc.Width(), offsety + rc.Height());
-    pDWR->DrawRect(&rectf);
-#endif
+  bool ok = false;
+  if (memBitmap) {
+    int32_t rc = FamoCandidateUiPaint(&view, &skin, &input, &m_famo_layout,
+                                      m_famo_res, (void*)memDC.m_hDC);
+    ok = (rc == FAMO_UI_OK);
+  }
+  if (ok) {
+    CRect rclayer(0, 0, w, h);
+    _LayerUpdate(rclayer, memDC);
+  } else {
+    // R6 crash 隔离：绘制故障 → 隐藏候选窗，composition 不受影响（永不丢键）。
+    ShowWindow(SW_HIDE);
   }
+  ::DeleteDC(memDC);
+  if (memBitmap)
+    ::DeleteObject(memBitmap);
+  return ok;
 }
