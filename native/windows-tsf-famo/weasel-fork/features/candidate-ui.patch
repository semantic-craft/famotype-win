+  if (hide_candidates) {
+    ShowWindow(SW_HIDE);
+    return false;
+  }
+  FamoSkin skin = _FamoSkinFromStyle(m_style);
+  _FamoEnsureTextRes(skin, dpi);
+
+  std::vector<FamoCandidate> cands;
+  std::vector<std::string> u8;
+  FamoCompositionView view = _FamoViewFromContext(m_ctx, m_status, cands, u8);
+
+  std::string aux_u8 = wtou8(m_ctx.aux.str);
+  RECT work = {0, 0, 0, 0};
+  HMONITOR mon = MonitorFromRect(m_inputPos, MONITOR_DEFAULTTONEAREST);
+  if (mon) {
+    MONITORINFO mi;
+    mi.cbSize = sizeof(MONITORINFO);
+    if (GetMonitorInfo(mon, &mi))
+      work = mi.rcWork;
