+std::string RimeWithWeaselHandler::_ReadFamoSelectSchema() {
+  // 读 famo-select-schema.txt（单行 schema id），trim 前后空白/换行；缺失或空返回空串。
+  std::string s = _ReadFamoFile(L"famo-select-schema.txt");
+  size_t b = s.find_first_not_of(" \t\r\n");
+  if (b == std::string::npos)
+    return std::string();
+  size_t e = s.find_last_not_of(" \t\r\n");
+  return s.substr(b, e - b + 1);
+}
+
+void RimeWithWeaselHandler::SelectSchema() {
+  // 法墨即时输入方式②：读 famo-select-schema.txt，select_schema 到所有活动会话（不部署、不重建 prism）。
+  LOG(INFO) << "Famo: SelectSchema (instant schema switch, no deploy).";
+  if (m_disabled)
+    return;
+  std::string id = _ReadFamoSelectSchema();
+  if (id.empty())
+    return;
+  for (auto& pair : m_session_status_map)
+    rime_api->select_schema(to_session_id(pair.first), id.c_str());
+  if (m_active_session)
+    _UpdateUI(m_active_session);  // 切到新方案后即时刷新候选窗/状态栏
+}
