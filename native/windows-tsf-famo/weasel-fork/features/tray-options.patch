-void WeaselTrayIcon::CustomizeMenu(HMENU hMenu) {}
+void WeaselTrayIcon::CustomizeMenu(HMENU hMenu) {
+  // 法墨：在右键菜单顶部追加 macOS 输入法菜单核心项。4 个即时开关用动作型标题
+  //（「切换至...」「使用...」）反映点击后的结果，而不是显示 Windows 状态型勾选项。
+  // 点击经 WeaselServerApp 的 handler 直达 FamoStatusBar::ToggleOption →
+  // RimeWithWeaselHandler::SetOption（零部署即时生效）。未注入查询时按关闭态生成菜单，
+  // 仍不得回退到上游 Weasel 资源菜单。
+  // 上游资源菜单包含词典、同步、帮助、检查更新等旧 Weasel 项；法墨托盘菜单
+  // 必须从空菜单重建，避免出现已移除/未实现的可点击项。
+  while (::GetMenuItemCount(hMenu) > 0)
+    ::DeleteMenu(hMenu, 0, MF_BYPOSITION);
+  int pos = 0;
+  auto add_toggle = [&](UINT id, const char* opt, const wchar_t* off_text,
+                        const wchar_t* on_text) {
+    const bool enabled = m_option_query ? m_option_query(opt) : false;
+    const wchar_t* text = enabled ? on_text : off_text;
+    ::InsertMenuW(hMenu, pos++, MF_BYPOSITION | MF_STRING, id, text);
+  };
+  auto add_action = [&](UINT id, const wchar_t* text) {
+    ::InsertMenuW(hMenu, pos++, MF_BYPOSITION | MF_STRING, id, text);
+  };
+  add_toggle(ID_WEASELTRAY_OPT_ASCII_MODE, "ascii_mode", L"切换至英文输入",
+             L"切换至中文输入");
+  add_toggle(ID_WEASELTRAY_OPT_TRADITIONALIZE, "traditionalization",
+             L"切换至繁体输入", L"切换至简体输入");
+  add_toggle(ID_WEASELTRAY_OPT_ASCII_PUNCT, "ascii_punct",
+             L"使用英文标点符号", L"使用中文标点符号");
+  add_toggle(ID_WEASELTRAY_OPT_FULL_SHAPE, "full_shape", L"使用全角输入",
+             L"使用半角输入");
+  ::InsertMenuW(hMenu, pos++, MF_BYPOSITION | MF_SEPARATOR, 0, nullptr);
+  add_action(ID_WEASELTRAY_SETTINGS, L"设置…");
+  add_action(ID_WEASELTRAY_FAMO_STATUS_BAR, L"显示悬浮状态条");
+  ::InsertMenuW(hMenu, pos++, MF_BYPOSITION | MF_SEPARATOR, 0, nullptr);
+  add_action(ID_WEASELTRAY_DEPLOY, L"刷新配置");
+  add_action(ID_WEASELTRAY_QUIT, L"退出");
+}
 
