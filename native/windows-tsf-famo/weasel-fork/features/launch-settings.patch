+  static bool launch_famo_settings(const fs::path& dir, const std::wstring& page) {
+    fs::path settings = dir / L"settings" / L"FamoSettings.exe";
+    if (!fs::exists(settings))
+      settings = dir / L"FamoSettings.exe";
+    return execute(settings, L"--page " + page);
+  }
