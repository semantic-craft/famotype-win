<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Famo.Settings.Core</RootNamespace>
    <AssemblyName>Famo.Settings.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.2.2" />
  </ItemGroup>

  <!-- Single source of truth: the settings default + schema live in famo-config/.
       Embed them so the store/validator work without depending on repo layout. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\famo-config\famo-settings.default.json"
                      Link="Resources\famo-settings.default.json"
                      LogicalName="famo-settings.default.json" />
    <EmbeddedResource Include="..\..\famo-config\famo-settings.schema.json"
                      Link="Resources\famo-settings.schema.json"
                      LogicalName="famo-settings.schema.json" />
    <EmbeddedResource Include="..\..\famo-config\overlay\weasel.custom.yaml"
                      Link="Resources\weasel.custom.yaml"
                      LogicalName="weasel.custom.yaml" />
    <EmbeddedResource Include="..\..\famo-config\overlay\rime_ice.custom.yaml"
                      Link="Resources\rime_ice.custom.yaml"
                      LogicalName="rime_ice.custom.yaml" />
  </ItemGroup>

</Project>
