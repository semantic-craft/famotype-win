<?xml version="1.0" encoding="utf-8"?>
<!-- 法墨「Claude Design」组件套件样式。色用运行时注入的 Famo.* 笔刷（FamoTheme.Apply 原地改 Color）。
     几何对齐设计稿：窗16 · 卡13 · 控件8 · field7 · 徽标r6。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 几何 ── -->
    <CornerRadius x:Key="Famo.RWin">16</CornerRadius>
    <CornerRadius x:Key="Famo.RCard">13</CornerRadius>
    <CornerRadius x:Key="Famo.RSmall">8</CornerRadius>
    <CornerRadius x:Key="Famo.RField">7</CornerRadius>
    <CornerRadius x:Key="Famo.RBadge">6</CornerRadius>
    <CornerRadius x:Key="Famo.RPill">11</CornerRadius>

    <!-- ── 字体（衬线标题回退到中文宋体；正文系统）── -->
    <FontFamily x:Key="Famo.Serif">Source Han Serif SC, Noto Serif SC, Songti SC, SimSun, Georgia, serif</FontFamily>
    <FontFamily x:Key="Famo.Mono">Cascadia Code, Consolas, ui-monospace, monospace</FontFamily>

    <!-- ── 分组卡片 ── -->
    <Style x:Key="FamoCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Famo.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Famo.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Famo.RCard}" />
        <Setter Property="Padding" Value="16,14,16,6" />
    </Style>

    <!-- ── 卡片衬线小标题 ── -->
    <Style x:Key="FamoSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Famo.Serif}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource Famo.Ink2}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- ── 行标题 / 行说明 ── -->
    <Style x:Key="FamoRowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Famo.Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FamoRowDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Famo.Ink3}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="FamoPaneTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Famo.Ink}" />
    </Style>
    <Style x:Key="FamoPaneDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Famo.Ink2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- ── 药丸开关 38×22（ToggleButton 自绘）── -->
    <Style x:Key="FamoPill" TargetType="ToggleButton">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="{StaticResource Famo.RPill}"
                                Background="{StaticResource Famo.Ink3_35}" />
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{StaticResource Famo.Knob}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{StaticResource Famo.Accent}" />
                                        <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                        <Setter Target="Knob.Margin" Value="0,0,2,0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 方形勾选 18×18（ToggleButton 自绘）── -->
    <Style x:Key="FamoCheck" TargetType="ToggleButton">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Box" CornerRadius="5" Background="Transparent"
                                BorderBrush="{StaticResource Famo.Ink3_55}" BorderThickness="1.5" />
                        <Viewbox Margin="3">
                            <Path x:Name="Tick" Width="24" Height="24" Stretch="Uniform" Opacity="0"
                                  Stroke="{StaticResource Famo.OnAccent}" StrokeThickness="2.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5,13 L9,17 L19,6" />
                        </Viewbox>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{StaticResource Famo.Accent}" />
                                        <Setter Target="Box.BorderBrush" Value="{StaticResource Famo.Accent}" />
                                        <Setter Target="Tick.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 分段控件单项（ToggleButton；选中=accent 实填）── -->
    <Style x:Key="FamoSegItem" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Famo.Ink2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="CP" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Background" Value="{StaticResource Famo.Accent}" />
                                        <Setter Target="CP.Foreground" Value="{StaticResource Famo.OnAccent}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 分段控件外框（放一排 FamoSegItem）── -->
    <Style x:Key="FamoSegBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Famo.SegBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Famo.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Famo.RField}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ── 主按钮（accent 实填，整宽）── -->
    <Style x:Key="FamoFilled" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Famo.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Famo.OnAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Famo.AccentDeep}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource Famo.RSmall}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 状态行 ── -->
    <Style x:Key="FamoStatus" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Famo.Card2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Famo.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Famo.RSmall}" />
        <Setter Property="Padding" Value="13,9" />
    </Style>

</ResourceDictionary>
